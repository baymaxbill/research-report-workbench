{
  "name": "research-report-workbench",
  "version": "0.12.12",
  "description": "研报撰写工作台：研报拆解、PDF 圈选问答、五板块卡片、图表库与行业报告撰写（DSH 插件）",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.mjs",
    "check": "node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baymaxbill/research-report-workbench.git"
  },
  "homepage": "https://github.com/baymaxbill/research-report-workbench#readme",
  "bugs": {
    "url": "https://github.com/baymaxbill/research-report-workbench/issues"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "pdfjs-dist": "4.10.38"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "investment-research",
    "pdf",
    "reading",
    "report"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
